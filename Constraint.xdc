set_property PACKAGE_PIN F22 [get_ports {observation[0]}]
set_property PACKAGE_PIN G22 [get_ports {observation[1]}]
set_property PACKAGE_PIN H22 [get_ports {observation[2]}]
set_property PACKAGE_PIN F21 [get_ports {observation[3]}]
set_property PACKAGE_PIN H19 [get_ports {observation[4]}]
set_property PACKAGE_PIN H18 [get_ports {observation[5]}]
set_property PACKAGE_PIN H17 [get_ports {observation[6]}]
set_property PACKAGE_PIN M15 [get_ports {observation[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {observation[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {observation[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {observation[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {observation[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {observation[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {observation[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {observation[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {observation[0]}]
set_property PACKAGE_PIN T22 [get_ports {output_state[0]}]
set_property PACKAGE_PIN T21 [get_ports {output_state[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {output_state[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {output_state[0]}]
set_property PACKAGE_PIN Y9 [get_ports clk]
set_property PACKAGE_PIN N15 [get_ports reset]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports reset]
